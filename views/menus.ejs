
<!DOCTYPE html>
<html lang="ko">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>인하카페</title>

<style>
body {
  font-family: Arial;
  background: #eef5ff;
  margin: 30px;
}

h1 {
  background: #0055a5;
  color: white;
  text-align: center;
  padding: 25px;
}

h2 {
  color: #0055a5;
}

.box {
  background: white;
  padding: 20px;
  margin: 20px 0;
  border-radius: 10px;
}

button {
  background: #0066bb;
  color: white;
  border: none;
  padding: 10px;
  cursor: pointer;
}

input, select {
  padding: 8px;
  margin: 5px;
}

table {
  width: 100%;
  border-collapse: collapse;
}

th, td {
  border: 1px solid #ddd;
  padding: 12px;
  text-align: center;
}

th {
  background: #d5e8ff;
}

.delete {
  background: #d9534f;
}

.edit {
  display: none;
}
</style>
</head>

<body>

<h1>☕ 인하카페</h1>

<!-- 메뉴 검색 -->
<div class="box">
  <h2>메뉴 검색</h2>

  <input id="search" placeholder="메뉴 이름 검색">

  <button onclick="searchMenu()">검색</button>
  <button onclick="showAll()">전체 조회</button>
</div>

<!-- 메뉴 추가 -->
<div class="box">
  <h2>메뉴 추가</h2>

  <form action="/menus/add" method="POST">

    <input name="name" placeholder="메뉴 이름" required>

    <input type="number" name="price"
           placeholder="가격" min="0" required>

    <select name="category">
      <option value="커피">커피</option>
      <option value="에이드">에이드</option>
      <option value="디저트">디저트</option>
    </select>

    <button type="submit">추가</button>
  </form>
</div>

<!-- 카테고리별 메뉴 목록 -->
<% ['커피', '에이드', '디저트'].forEach(category => { %>

<div class="box">
  <h2><%= category %> 메뉴</h2>

  <table>
    <tr>
      <th>번호</th>
      <th>메뉴 이름</th>
      <th>가격</th>
      <th>관리</th>
    </tr>

    <% menus.filter(menu => menu.category === category).forEach(menu => { %>

    <tr class="menu" data-name="<%= menu.name %>">

      <td><%= menu.id %></td>
      <td><%= menu.name %></td>
      <td><%= Number(menu.price).toLocaleString() %>원</td>

      <td>
        <button onclick="editMenu(<%= menu.id %>)">
          수정
        </button>

        <form action="/menus/delete/<%= menu.id %>"
              method="POST" style="display:inline"
              onsubmit="return confirm('삭제할까요?')">

          <button type="submit" class="delete">
            삭제
          </button>
        </form>
      </td>
    </tr>

    <!-- 메뉴 수정 -->
    <tr id="edit<%= menu.id %>" class="edit">
      <td colspan="4">

        <form action="/menus/update/<%= menu.id %>"
              method="POST">

          <input name="name"
                 value="<%= menu.name %>" required>

          <input type="number" name="price"
                 value="<%= menu.price %>"
                 min="0" required>

          <select name="category">
            <option value="커피"
              <%= menu.category === '커피' ? 'selected' : '' %>>
              커피
            </option>

            <option value="에이드"
              <%= menu.category === '에이드' ? 'selected' : '' %>>
              에이드
            </option>

            <option value="디저트"
              <%= menu.category === '디저트' ? 'selected' : '' %>>
              디저트
            </option>
          </select>

          <button type="submit">저장</button>
          <button type="button" onclick="editMenu(<%= menu.id %>)">
            취소
          </button>
        </form>
      </td>
    </tr>

    <% }) %>
  </table>
</div>

<% }) %>

<script>
// 메뉴 이름 검색
function searchMenu() {
  let keyword = document.getElementById("search").value;

  document.querySelectorAll(".menu").forEach(row => {
    if (row.dataset.name.includes(keyword)) {
      row.style.display = "";
    } else {
      row.style.display = "none";
    }
  });

  document.querySelectorAll(".edit").forEach(row => {
    row.style.display = "none";
  });
}

// 전체 메뉴 다시 표시
function showAll() {
  document.getElementById("search").value = "";

  document.querySelectorAll(".menu").forEach(row => {
    row.style.display = "";
  });

  document.querySelectorAll(".edit").forEach(row => {
    row.style.display = "none";
  });
}

// 메뉴 수정창 열기 / 닫기
function editMenu(id) {
  let row = document.getElementById("edit" + id);

  if (row.style.display === "table-row") {
    row.style.display = "none";
  } else {
    row.style.display = "table-row";
  }
}
</script>

</body>
</html>

